# =====================================================================
# PINK AI Smart Parking System Configuration (.env.example)
# ห้ามใส่รหัสผ่านจริงหรือ Secret จริงลงในไฟล์ตัวอย่างนี้
# คัดลอกไฟล์นี้เป็น .env แล้วตั้งค่าตามสภาพแวดล้อมจริง
# =====================================================================

# --- 1. Security & JWT Authentication ---
JWT_SECRET_KEY=CHANGE_ME_TO_A_SECURE_RANDOM_SECRET_KEY
JWT_EXPIRE_HOURS=24
TIMEZONE=Asia/Bangkok

# --- 2. Database Configuration (SQLite Primary / MySQL Optional) ---
SQLITE_DB_PATH=parking_local.db
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASS=
DB_NAME=parking

# --- 3. Google Sheets & Apps Script Integration ---
GOOGLE_SPREADSHEET_ID=13f4DDoMFIU5ytBqIuEqXpUcW5rBRVG_GBAY0mSWrtiQ
# นำ Web App URL (ลงท้ายด้วย /exec) ที่ได้จากการ Deploy ไฟล์ google_apps_script/Code.gs มาใส่ที่นี่
GOOGLE_SHEETS_WEBAPP_URL=
GOOGLE_SHEETS_SYNC_SECRET=

# --- 4. Weather API Service (Open-Meteo Campus Reference) ---
CAMPUS_LATITUDE=13.7563
CAMPUS_LONGITUDE=100.5018
WEATHER_CACHE_TTL_SEC=1200

# --- 5. MQTT Broker & CiRA CORE / AI Service ---
MQTT_HOST=127.0.0.1
MQTT_PORT=1883
MQTT_KEEPALIVE=60

# --- 6. RTSP / Agent DVR Camera Gateway ---
AGENT_DVR_URL=http://172.20.10.6:8090
CAM_GATE_OID=1
CAM_SLOT_OID=

# --- 7. Gate Barrier Controller Timing ---
GATE_OPEN_SEC=5.0
PLATE_COOLDOWN_SEC=15.0
PLATE_CONFIRM_COUNT=3
PLATE_CONFIRM_WINDOW_SEC=3.0

# --- 8. Future External Integrations (Prepared Hooks) ---
LINE_CHANNEL_ACCESS_TOKEN=
LINE_CHANNEL_SECRET=
UNIVERSITY_SCHEDULE_API_URL=
UNIVERSITY_SCHEDULE_API_KEY=

# --- 9. Web Dashboard & API Server ---
WEB_HOST=0.0.0.0
WEB_PORT=8000
